# Copy this file to .env and fill in the values. Never commit .env.
# Ask the team lead for the database password. Don't share it in group chats.

# Supabase: open the project, click the green "Connect" button, choose "Session pooler",
# and copy the URI. Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# Google sign-in. The client ID is public, so the real value is here: copy it as is.
# (From the chapter account's Google Cloud project "Chapter Ops App".)
GOOGLE_CLIENT_ID=173128104801-6hvs5eodo2isng6nm9u4phg4njtpts0d.apps.googleusercontent.com

# The client secret is NOT public. Ask the team lead for it. Never commit it or share it in chat.
GOOGLE_CLIENT_SECRET=

# Where Google sends the browser after sign-in. Must match the console exactly.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
